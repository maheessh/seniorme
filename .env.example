# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL="postgresql://ccc:ccc@localhost:5432/ccc?schema=public"

# --- Redis (used by the worker; queue/scheduler land in Phase 2) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (single-user login) ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# The one account this app will ever have. Used by the db seed script.
APP_USER_EMAIL="you@example.com"
APP_USER_PASSWORD="change-me-before-seeding"

# --- Optional: Phase 5 job-link-import LLM fallback extraction ---
ANTHROPIC_API_KEY=""
