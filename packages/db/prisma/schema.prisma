generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// -------------------- Enums --------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum EmploymentType {
  INTERNSHIP
  NEW_GRAD
  FULL_TIME
  CONTRACT
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum SourceType {
  GREENHOUSE
  LEVER
  ASHBY
  ICIMS
  SMARTRECRUITERS
  WORKDAY
  CUSTOM_JSONLD
  CUSTOM_HTML
}

enum ScrapeStatus {
  SUCCESS
  PARTIAL_SUCCESS
  FAILURE
}

enum InboxStatus {
  NEW
  SAVED
  APPLIED
  IGNORED
}

enum ApplicationStage {
  SAVED
  PREPARING
  APPLIED
  OA
  RECRUITER_SCREEN
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  CLOSED
}

enum ProjectStatus {
  IDEA
  PLANNING
  BUILDING
  TESTING
  COMPLETED
}

enum GoalCategory {
  PROJECT
  CODING_PRACTICE
  APPLICATIONS
  INTERVIEW_PREP
  LEARNING
  RESUME
  COURSEWORK
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum NotificationType {
  NEW_MATCHING_JOB
  DEADLINE_APPROACHING
  FOLLOW_UP_DUE
  INTERVIEW_APPROACHING
  GOAL_DEADLINE
  SCRAPER_FAILING
}

// -------------------- Models --------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Set by @auth/prisma-adapter when an OAuth provider reports the email as verified
  /// (Google/GitHub both do on every sign-in) — part of Auth.js's standard Prisma schema
  /// contract, not something this app reads itself.
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  userCompanies UserCompany[]
  jobStatuses   UserJobStatus[]
  applications  Application[]
  contacts      Contact[]
  projects      Project[]
  goals         Goal[]
  activity      ActivityEvent[]
  notifications Notification[]
}

/// Auth.js OAuth account-linking table. JWT session strategy is used, so no
/// Session/VerificationToken tables are needed.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

/// Shared catalog: one row per real-world company, the same for every user. Personal fields
/// (priority, notes, scrape-scope filters, monitoring) live on UserCompany instead — two users
/// tracking the same company share its scraped jobs but never each other's preferences.
model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  logoUrl   String?
  website   String?
  location  String?
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careerSources CareerSource[]
  jobs          Job[]
  applications  Application[]
  contacts      Contact[]
  userCompanies UserCompany[]
}

/// A user's personal relationship to a shared Company: whether they track it, how they've
/// configured it, and their own scrape-scope filters. Absence of a row for a given
/// (userId, companyId) means "not tracked."
model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priority  Priority @default(MEDIUM)
  notes     String?
  rolesOfInterest String[]
  /// Scrape-scope filter: only surface postings whose location contains one of these
  /// (case-insensitive substring match) — empty means no location filter. Applied when reading
  /// this user's Inbox, not at scrape time, since the underlying Job catalog is shared and must
  /// stay complete for every other user tracking the same company.
  targetLocationKeywords String[] @default([])
  /// Scrape-scope filter: only surface postings posted within this many days — null means no
  /// age filter. A posting with no known post date is never excluded by this.
  maxPostingAgeDays Int?
  /// Whether this user gets notified about new postings / scraper failures for this company.
  /// Independent of whether the CareerSource itself is actively scraped (see
  /// CareerSource.isActive) — monitoring the board is shared infrastructure that keeps running
  /// as long as anyone tracks the company; this only gates this user's own notifications.
  monitoringEnabled Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model CareerSource {
  id                  String     @id @default(cuid())
  companyId           String
  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url                 String
  sourceType          SourceType @default(CUSTOM_HTML)
  checkFrequencyMin   Int        @default(1440)
  isActive            Boolean    @default(true)
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int        @default(0)
  lastError           String?
  createdAt           DateTime   @default(now())

  scrapeRuns ScrapeRun[]
  jobs       Job[]

  @@unique([companyId, url])
}

model ScrapeRun {
  id             String       @id @default(cuid())
  careerSourceId String
  careerSource   CareerSource @relation(fields: [careerSourceId], references: [id], onDelete: Cascade)
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  status         ScrapeStatus
  jobsFound      Int          @default(0)
  jobsNew        Int          @default(0)
  errorMessage   String?
  triggeredBy    String

  @@index([careerSourceId, startedAt])
}

model Job {
  id                 String        @id @default(cuid())
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])
  careerSourceId     String?
  careerSource       CareerSource? @relation(fields: [careerSourceId], references: [id])

  title              String
  location           String?
  workMode           WorkMode      @default(UNKNOWN)
  employmentType     EmploymentType?
  url                String
  canonicalUrlHash   String        @unique
  externalJobId      String?
  descriptionRaw     String?
  descriptionHash    String?
  salaryMin          Int?
  salaryMax          Int?
  postedAt           DateTime?
  discoveredAt       DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  isRemoved          Boolean       @default(false)
  possibleDuplicateOfId String?
  possibleDuplicateOf   Job?       @relation("JobDuplicates", fields: [possibleDuplicateOfId], references: [id])
  duplicateCandidates   Job[]      @relation("JobDuplicates")

  applications Application[]
  activity     ActivityEvent[]
  userStatuses UserJobStatus[]

  @@unique([companyId, externalJobId])
  @@index([discoveredAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// A user's personal triage state for a shared Job row. Absence of a row for a given
/// (userId, jobId) means "not yet triaged" — treated as NEW.
model UserJobStatus {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    InboxStatus @default(NEW)
  updatedAt DateTime    @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([status, updatedAt])
}

model Application {
  id                  String            @id @default(cuid())
  jobId               String
  job                 Job               @relation(fields: [jobId], references: [id])
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  stage               ApplicationStage  @default(SAVED)
  appliedAt           DateTime?
  deadline            DateTime?
  followUpDate        DateTime?
  resumeVersion       String?
  coverLetter         String?
  recruiterContactId  String?
  contact             Contact?          @relation(fields: [recruiterContactId], references: [id])
  notes               String?
  descriptionSnapshot String?

  events    ApplicationEvent[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, jobId])
  @@index([userId, stage])
  @@index([deadline])
  @@index([followUpDate])
}

model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  note          String?
  scheduledAt   DateTime?
  occurredAt    DateTime          @default(now())

  @@index([applicationId, occurredAt])
  @@index([scheduledAt])
}

model Contact {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  role        String?
  email       String?
  linkedInUrl String?
  notes       String?

  applications Application[]

  @@index([userId])
}

model Project {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  repoUrl         String?
  demoUrl         String?
  technologies    String[]
  status          ProjectStatus @default(IDEA)
  priority        Priority      @default(MEDIUM)
  startDate       DateTime?
  targetDate      DateTime?
  progressPercent Int           @default(0)
  notes           String?

  tasks     ProjectTask[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
}

model ProjectTask {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  isDone    Boolean   @default(false)
  dueDate   DateTime?
  order     Int       @default(0)
}

model Goal {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     GoalCategory
  targetValue  Int?
  currentValue Int          @default(0)
  deadline     DateTime?
  priority     Priority     @default(MEDIUM)
  status       GoalStatus   @default(NOT_STARTED)
  notes        String?

  milestones GoalMilestone[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId])
  @@index([deadline])
}

model GoalMilestone {
  id      String    @id @default(cuid())
  goalId  String
  goal    Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title   String
  isDone  Boolean   @default(false)
  dueDate DateTime?
}

/// A mix of shared, system-generated events about the catalog (job discovered/updated — no
/// natural owner, userId null) and personal events about one user's own actions (status
/// changes, applications — userId set). Null is "everyone tracking this job might care",
/// not "unowned".
model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  entityType String
  entityId   String
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id])
  summary    String
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@index([entityType, entityId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  linkUrl    String?
  entityType String?
  entityId   String?
  /// Stable key (e.g. "deadline:{applicationId}:{date}") used to avoid re-notifying this user
  /// for the same underlying event on every periodic check. Company-wide triggers (new job,
  /// scraper failing) fan out to one row per user tracking that company, each independently
  /// deduped — the same dedupeKey recurring once per user is expected, not a collision.
  dedupeKey  String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([entityType, entityId])
}
